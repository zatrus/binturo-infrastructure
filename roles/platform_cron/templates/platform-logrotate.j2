{{ platform_application_log_file }} {{ platform_cron_log_file }} {
    daily
    maxsize 10M
    maxage 90
    rotate 1000
    missingok
    notifempty
    copytruncate
    dateext
    dateformat -%Y%m%d-%H%M%S
    olddir {{ platform_log_directory }}/archive
    su {{ binturo_user }} {{ binturo_group }}
}
