      "options": {}
    },
    {
      "id": 7,
      "title": "Udział błędów 5xx %",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-prod"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum by (service) (rate(binturo_http_requests_total{status_class=\"5xx\"}[5m])) / clamp_min(sum by (service) (rate(binturo_http_requests_total[5m])), 0.000001)",
          "legendFormat": "{{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 8,
      "title": "Najczęściej wywoływane trasy",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-prod"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, sum by (service, route) (rate(binturo_http_requests_total[5m])))",
          "legendFormat": "{{service}} {{route}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 9,
      "title": "Najwięcej błędów 5xx według trasy",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-prod"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, sum by (service, route) (increase(binturo_http_requests_total{status_class=\"5xx\"}[1h])))",
          "legendFormat": "{{service}} {{route}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    }
  ]
