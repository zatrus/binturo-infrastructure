{
  "uid": "binturo-staging-engagement",
  "title": "Binturo / Zapisy i komunikacja",
  "tags": [
    "binturo",
    "staging",
    "biznes"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "editable": false,
  "refresh": "5m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Zapisy i anulowania / 24 h",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-staging"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (event, channel) (increase(binturo_enrollment_events_total[1d]))",
          "legendFormat": "{{event}} · {{channel}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 2,
      "title": "Zapisy samoobsługowe i przez personel",
