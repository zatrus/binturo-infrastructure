{
  "uid": "binturo-staging-subscriptions",
  "title": "Binturo / Subskrypcje i płatności",
  "tags": [
    "binturo",
    "staging",
    "biznes"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "editable": false,
  "refresh": "5m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Subskrypcje według statusu",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-staging"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count by (subscription_status) (last_over_time(binturo_platform_organizer_subscription_info[48h]))",
          "legendFormat": "{{subscription_status}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value"
      }
    },
    {
      "id": 2,
      "title": "Plany subskrypcji",
      "type": "stat",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-staging"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count by (plan_name) (last_over_time(binturo_platform_organizer_subscription_info[48h]))",
          "legendFormat": "{{plan_name}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value"
      }
    },
    {
      "id": 3,
      "title": "Wygasają w ciągu 7 dni",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-staging"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count((last_over_time(binturo_platform_organizer_subscription_valid_until_timestamp_seconds[48h]) - time() < 7 * 86400) and (last_over_time(binturo_platform_organizer_subscription_valid_until_timestamp_seconds[48h]) > time())) or vector(0)",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value"
      }
    },
    {
      "id": 4,
      "title": "Zdarzenia subskrypcji / 24 h",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-staging"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (increase(binturo_subscription_payment_events_total[1d]))",
          "legendFormat": "{{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 5,
      "title": "Kwota płatności brutto / 24 h",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-staging"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (increase(binturo_subscription_payment_amount_gross_total[1d]))",
          "legendFormat": "{{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyPLN"
        },
        "overrides": []
      },
      "options": {},
      "description": "Kwota brutto w PLN; applied_mock oznacza płatności testowe, nie rzeczywisty przychód ani MRR."
    },
    {
      "id": 6,
      "title": "Płatności testowe / 24 h",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-staging"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(binturo_subscription_payment_amount_gross_total{outcome=\"applied_mock\"}[1d]))",
          "legendFormat": "mock"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyPLN"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 7,
      "title": "Płatności rzeczywiste / 24 h",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-staging"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(binturo_subscription_payment_amount_gross_total{outcome=\"finalized\"}[1d]))",
          "legendFormat": "finalized"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyPLN"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 8,
      "title": "Cron: kończące się i wygasłe subskrypcje",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 21,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-staging"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "binturo_platform_cron_limits_expiring_soon or binturo_platform_cron_limits_expired",
          "legendFormat": "{{__name__}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    }
  ]
}
