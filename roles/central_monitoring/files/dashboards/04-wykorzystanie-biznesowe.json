{
  "uid": "binturo-staging-business",
  "title": "Binturo / Wykorzystanie biznesowe",
  "tags": [
    "binturo",
    "staging",
    "biznes"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "5m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Zapisy i anulowania / 24 h",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-staging"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (event, channel) (increase(binturo_enrollment_events_total[1d]))",
          "legendFormat": "{{event}} · {{channel}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 2,
      "title": "Sfinalizowane płatności / 24 h",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-staging"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (kind) (increase(binturo_payment_finalized_total[1d]))",
          "legendFormat": "{{kind}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 3,
      "title": "Zdarzenia subskrypcji / 24 h",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-staging"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (increase(binturo_subscription_payment_events_total[1d]))",
          "legendFormat": "{{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 4,
      "title": "Aktywni klienci organizacji",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-staging"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(binturo_organizer_clients_active_total)",
          "legendFormat": "klienci"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 5,
      "title": "Organizacje według statusu",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-staging"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count by (status) (binturo_organizer_info)",
          "legendFormat": "{{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 6,
      "title": "Zajęcia w tym tygodniu",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-staging"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(binturo_organizer_classes_current_week_total)",
          "legendFormat": "zajęcia"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    }
  ]
}
