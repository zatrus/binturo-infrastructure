# Managed by Ansible. Local changes will be overwritten.
{{ item.domain }} {
    bind {{ caddy_bind_addresses | join(' ') }}
    import binturo_common

    log {
        output file {{ caddy_log_dir }}/{{ item.log_filename }} {
            mode 0640
            roll_at {{ caddy_log_roll_at }}
            roll_size {{ caddy_log_roll_size }}
            roll_local_time
            roll_keep {{ caddy_log_roll_keep }}
            roll_keep_for {{ caddy_log_roll_keep_for }}
        }
        format json
    }

    @backend_api path /api /api/*
    handle @backend_api {
        reverse_proxy 127.0.0.1:{{ item.backend_port }} {
            header_up X-Real-IP {remote_host}
        }
    }

    handle {
        route {
            root * {{ item.frontend_root }}
            header Cache-Control "no-cache"
            @platform_assets {
                path /assets/*
                file
            }
            header @platform_assets Cache-Control "public, max-age=31536000, immutable"
            try_files {path} /index.html
            file_server
        }
    }
}
