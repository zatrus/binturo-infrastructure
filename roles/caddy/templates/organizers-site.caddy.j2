# Managed by Ansible. Local changes will be overwritten.
{{ binturo_domains.organizers }} {
    bind {{ caddy_bind_addresses | join(' ') }}
    import binturo_common

    log {
        output file {{ caddy_log_dir }}/organizers.log {
            mode 0640
            roll_at {{ caddy_log_roll_at }}
            roll_size {{ caddy_log_roll_size }}
            roll_local_time
            roll_keep {{ caddy_log_roll_keep }}
            roll_keep_for {{ caddy_log_roll_keep_for }}
        }
        format json
    }

    # Operator access uses the same production origin as customers, so CORS,
    # cookies and frontend routing are tested under real conditions. The raw
    # bypass token never appears in the URL or access log.
    route /__maintenance-access {
        basicauth {
            {{ caddy_maintenance_basic_auth_username }} {{ caddy_maintenance_basic_auth_password_hash }}
        }
        header Set-Cookie "{{ caddy_maintenance_cookie_name }}={{ caddy_maintenance_bypass_token }}; Path=/; Max-Age={{ caddy_maintenance_cookie_max_age }}; Secure; HttpOnly; SameSite=Strict"
        redir /staff/login 303
    }

    @maintenance_api {
        path /api /api/*
        not header Cookie *{{ caddy_maintenance_cookie_name }}={{ caddy_maintenance_bypass_token }}*
        file {
            root {{ caddy_maintenance_dir }}
            try_files {{ caddy_maintenance_marker }}
        }
    }
    handle @maintenance_api {
        header Cache-Control "no-store"
        header Content-Type "application/json; charset=utf-8"
        header Retry-After "{{ caddy_maintenance_retry_after }}"
        respond `{"detail":"Trwają prace serwisowe. Spróbuj ponownie za kilka minut."}` 503
    }

    @maintenance_frontend {
        path /staff /staff/* /trainer /trainer/* /client /client/*
        not header Cookie *{{ caddy_maintenance_cookie_name }}={{ caddy_maintenance_bypass_token }}*
        file {
            root {{ caddy_maintenance_dir }}
            try_files {{ caddy_maintenance_marker }}
        }
    }
    handle @maintenance_frontend {
        header Cache-Control "no-store"
        header Retry-After "{{ caddy_maintenance_retry_after }}"
        root * {{ caddy_maintenance_dir }}
        rewrite * /index.html
        file_server {
            status 503
        }
    }

{% if caddy_tls_cloudflare_origin %}
    @backend_api_from_cloudflare {
        path /api /api/*
        remote_ip {{ (caddy_cloudflare_ipv4_ranges + caddy_cloudflare_ipv6_ranges) | join(' ') }}
    }

    handle @backend_api_from_cloudflare {
        reverse_proxy 127.0.0.1:{{ binturo_ports.organizers }} {
            header_up X-Real-IP {http.request.header.CF-Connecting-IP}
            header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
        }
    }
{% endif %}

    @backend_api path /api /api/*
    handle @backend_api {
        reverse_proxy 127.0.0.1:{{ binturo_ports.organizers }} {
            header_up X-Real-IP {remote_host}
        }
    }

    redir /staff /staff/
    redir /trainer /trainer/
    redir /client /client/

    handle_path /staff/* {
        route {
            root * {{ binturo_frontend_roots.organizers_staff }}
            header Cache-Control "no-cache"
            @staff_assets {
                path /assets/*
                file
            }
            header @staff_assets Cache-Control "public, max-age=31536000, immutable"
            try_files {path} /index.html
            file_server
        }
    }

    handle_path /trainer/* {
        route {
            root * {{ binturo_frontend_roots.organizers_trainer }}
            header Cache-Control "no-cache"
            @trainer_assets {
                path /assets/*
                file
            }
            header @trainer_assets Cache-Control "public, max-age=31536000, immutable"
            try_files {path} /index.html
            file_server
        }
    }

    handle_path /client/* {
        route {
            root * {{ binturo_frontend_roots.organizers_client }}
            header Cache-Control "no-cache"
            @client_assets {
                path /assets/*
                file
            }
            header @client_assets Cache-Control "public, max-age=31536000, immutable"
            try_files {path} /index.html
            file_server
        }
    }

    redir / /staff/login
}
