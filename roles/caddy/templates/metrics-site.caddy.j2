# Managed by Ansible. UFW blocks external access to this dedicated listener.
http://:{{ binturo_ports.caddy_metrics }} {
    @metrics {
        method GET
        path /metrics
    }
    handle @metrics {
        reverse_proxy 127.0.0.1:2019 {
            header_up Host 127.0.0.1:2019
        }
    }
    @platform_metrics {
        method GET
        path /platform/metrics
    }
    handle @platform_metrics {
        rewrite * /metrics
        reverse_proxy 127.0.0.1:{{ binturo_ports.platform }}
    }
    @organizers_metrics {
        method GET
        path /organizers/metrics
    }
    handle @organizers_metrics {
        rewrite * /metrics
        reverse_proxy 127.0.0.1:{{ binturo_ports.organizers }}
    }
    handle {
        respond 404
    }
}
