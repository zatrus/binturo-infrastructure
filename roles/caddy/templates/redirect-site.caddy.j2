# Managed by Ansible. Local changes will be overwritten.
{{ caddy_redirect_domains | join(', ') }} {
    bind {{ caddy_bind_addresses | join(' ') }}
    import binturo_common

    log {
        output file {{ caddy_log_dir }}/redirects.log {
            mode 0640
            roll_at {{ caddy_log_roll_at }}
            roll_size {{ caddy_log_roll_size }}
            roll_local_time
            roll_keep {{ caddy_log_roll_keep }}
            roll_keep_for {{ caddy_log_roll_keep_for }}
        }
        format json
    }

    @unknown_domain {
        not host {{ binturo_domains.values() | join(' ') }}
    }
    redir @unknown_domain https://{{ binturo_domains.www }}{uri} permanent

    # The API hostname is reserved for a future dedicated virtual host.
    # It must never silently become the public website.
    respond 404
}
