# Managed by Ansible. Local changes will be overwritten.
http://127.0.0.1:{{ item.port }} {
    route {
        root * {{ item.frontend_root }}
        header Cache-Control "no-cache"
        @frontend_assets {
            path /assets/*
            file
        }
        header @frontend_assets Cache-Control "public, max-age=31536000, immutable"
        try_files {path} /index.html
        file_server
    }
}
