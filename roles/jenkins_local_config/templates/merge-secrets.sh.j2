#!/usr/bin/env bash
set -Eeuo pipefail

readonly secrets_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
readonly fragments_dir="$secrets_dir/fragments"
readonly output_file="$secrets_dir/secrets.properties"
readonly fragment_names=(shared local staging production)

umask 077
temporary_file=$(mktemp -- "$secrets_dir/.secrets.properties.tmp.XXXXXX")
trap 'rm -f -- "$temporary_file"' EXIT

merged_count=0
for fragment_name in "${fragment_names[@]}"; do
  fragment_file="$fragments_dir/$fragment_name.properties"
  if [[ ! -f "$fragment_file" ]]; then
    printf 'WARNING: missing Jenkins secrets fragment: %s\n' "$fragment_file" >&2
    continue
  fi

  if ((merged_count > 0)); then
    printf '\n' >>"$temporary_file"
  fi
  cat -- "$fragment_file" >>"$temporary_file"
  merged_count=$((merged_count + 1))
done

if ((merged_count == 0)); then
  printf 'ERROR: no Jenkins secrets fragments found in %s\n' "$fragments_dir" >&2
  exit 1
fi

chmod 600 "$temporary_file"
mv -f -- "$temporary_file" "$output_file"
trap - EXIT
printf 'Merged %d fragment(s) into %s\n' "$merged_count" "$output_file"
