[CmdletBinding()]
param()

$ErrorActionPreference = "Stop"
$secretsDir = $PSScriptRoot
$fragmentsDir = Join-Path $secretsDir "fragments"
$outputFile = Join-Path $secretsDir "secrets.properties"
$temporaryFile = Join-Path $secretsDir (".secrets.properties.tmp." + [guid]::NewGuid().ToString("N"))
$fragmentNames = @("shared", "local", "staging", "production")
$utf8WithoutBom = New-Object System.Text.UTF8Encoding($false)
$parts = New-Object System.Collections.Generic.List[string]

try {
    foreach ($fragmentName in $fragmentNames) {
        $fragmentFile = Join-Path $fragmentsDir "$fragmentName.properties"
        if (-not (Test-Path -LiteralPath $fragmentFile -PathType Leaf)) {
            Write-Warning "Missing Jenkins secrets fragment: $fragmentFile"
            continue
        }

        $parts.Add([System.IO.File]::ReadAllText($fragmentFile))
    }

    if ($parts.Count -eq 0) {
        throw "No Jenkins secrets fragments found in $fragmentsDir"
    }

    [System.IO.File]::WriteAllText(
        $temporaryFile,
        ($parts -join [Environment]::NewLine),
        $utf8WithoutBom
    )
    Move-Item -LiteralPath $temporaryFile -Destination $outputFile -Force
    Write-Host "Merged $($parts.Count) fragment(s) into $outputFile"
}
finally {
    if (Test-Path -LiteralPath $temporaryFile) {
        Remove-Item -LiteralPath $temporaryFile -Force
    }
}
