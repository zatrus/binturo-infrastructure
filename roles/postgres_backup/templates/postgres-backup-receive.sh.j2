#!/usr/bin/env bash
set -euo pipefail
umask 077

backup_dir={{ postgres_backup_remote_dir | quote }}
command=${SSH_ORIGINAL_COMMAND:-}
if [[ ! "$command" =~ ^receive\ (binturo_prod_([0-9]{8})T([0-9]{6})Z\.dump\.gpg)\ ([a-f0-9]{64})$ ]]; then
  echo "denied" >&2
  exit 65
fi
filename=${BASH_REMATCH[1]}
expected=${BASH_REMATCH[4]}
temporary=$(mktemp "$backup_dir/.incoming.XXXXXX")
trap 'rm -f -- "$temporary"' EXIT
cat >"$temporary"
actual=$(sha256sum "$temporary" | awk '{print $1}')
[[ "$actual" == "$expected" ]] || { echo "checksum mismatch" >&2; exit 66; }
chmod 0600 "$temporary"
mv -- "$temporary" "$backup_dir/$filename"
printf '%s  %s\n' "$actual" "$filename" >"$backup_dir/$filename.sha256"
printf '{"environment":"prod","received_at":"%s","sha256":"%s"}\n' \
  "$(date -u +%Y%m%dT%H%M%SZ)" "$actual" >"$backup_dir/$filename.json"
trap - EXIT
/usr/local/sbin/binturo-postgres-backup-retention "$backup_dir"
echo "received $filename"
