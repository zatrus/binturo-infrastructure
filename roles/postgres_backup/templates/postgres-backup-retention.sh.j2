#!/usr/bin/env bash
set -euo pipefail

backup_dir="${1:?usage: binturo-postgres-backup-retention BACKUP_DIRECTORY}"
daily_seconds=$(({{ postgres_backup_daily_hours | int }} * 3600))
weekly_seconds=$(({{ postgres_backup_weekly_days | int }} * 86400))
max_age_seconds=$(({{ postgres_backup_max_age_days | int }} * 86400))
now_epoch=$(date -u +%s)

[[ -d "$backup_dir" ]] || exit 0
declare -A keep=()
declare -A weeks=()
declare -A months=()

mapfile -t files < <(
  find "$backup_dir" -maxdepth 1 -type f \
    -name 'binturo_*_[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]T[0-9][0-9][0-9][0-9][0-9][0-9]Z.dump.gpg' \
    -printf '%f\n' | sort -r
)

for file in "${files[@]}"; do
  if [[ ! "$file" =~ _([0-9]{8})T([0-9]{6})Z\.dump\.gpg$ ]]; then
    continue
  fi
  day=${BASH_REMATCH[1]}
  clock=${BASH_REMATCH[2]}
  stamp="${day:0:4}-${day:4:2}-${day:6:2} ${clock:0:2}:${clock:2:2}:${clock:4:2} UTC"
  if ! epoch=$(date -u -d "$stamp" +%s 2>/dev/null); then
    continue
  fi
  age=$((now_epoch - epoch))
  # This hard cap wins over all daily, weekly and monthly retention rules.
  if (( age >= max_age_seconds )); then
    continue
  fi
  week=$(date -u -d "@$epoch" +%G-W%V)
  month=$(date -u -d "@$epoch" +%Y-%m)
  if (( age <= daily_seconds )); then
    keep["$file"]=1
  elif (( age <= weekly_seconds )) && [[ -z "${weeks[$week]:-}" ]]; then
    weeks["$week"]=1
    keep["$file"]=1
  elif (( age <= max_age_seconds )) && [[ -z "${months[$month]:-}" ]]; then
    months["$month"]=1
    keep["$file"]=1
  fi
done

for file in "${files[@]}"; do
  if [[ -z "${keep[$file]:-}" ]]; then
    rm -f -- "$backup_dir/$file" "$backup_dir/$file.sha256" "$backup_dir/$file.json"
  fi
done
