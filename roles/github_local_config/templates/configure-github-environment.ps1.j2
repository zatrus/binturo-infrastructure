[CmdletBinding()]
param()

$ErrorActionPreference = 'Stop'

# Generated by Ansible for {{ inventory_hostname }}. Contains secrets.
$RepositoryBase64 = '{{ github_repository | b64encode }}'
$EnvironmentBase64 = '{{ github_environment_name | b64encode }}'

function ConvertFrom-Base64Utf8 {
    param([Parameter(Mandatory)][string]$Value)
    [Text.Encoding]::UTF8.GetString([Convert]::FromBase64String($Value))
}

function Invoke-Gh {
    param([Parameter(Mandatory)][string[]]$Arguments)
    & gh @Arguments
    if ($LASTEXITCODE -ne 0) {
        throw "gh failed with exit code ${LASTEXITCODE}: gh $($Arguments -join ' ')"
    }
}

function Set-GitHubVariable {
    param(
        [Parameter(Mandatory)][string]$Name,
        [Parameter(Mandatory)][string]$ValueBase64
    )
    $value = ConvertFrom-Base64Utf8 $ValueBase64
    Invoke-Gh @('variable', 'set', $Name, '--repo', $script:Repository, '--env', $script:Environment, '--body', $value)
}

function Set-GitHubSecret {
    param(
        [Parameter(Mandatory)][string]$Name,
        [Parameter(Mandatory)][string]$ValueBase64
    )
    $value = ConvertFrom-Base64Utf8 $ValueBase64
    $value | & gh secret set $Name --repo $script:Repository --env $script:Environment
    if ($LASTEXITCODE -ne 0) {
        throw "gh secret set failed for $Name with exit code $LASTEXITCODE"
    }
}

if (-not (Get-Command gh -ErrorAction SilentlyContinue)) {
    throw 'Missing required command: gh. Install GitHub CLI and run gh auth login.'
}

$script:Repository = ConvertFrom-Base64Utf8 $RepositoryBase64
$script:Environment = ConvertFrom-Base64Utf8 $EnvironmentBase64
Invoke-Gh @('auth', 'status')

Write-Host "Configuring GitHub Environment $Environment in $Repository"
Invoke-Gh @('api', '--method', 'PUT', "repos/$Repository/environments/$Environment", '--silent')

{% for name, value in github_environment_variables | dictsort %}
Set-GitHubVariable -Name '{{ name }}' -ValueBase64 '{{ value | string | b64encode }}'
{% endfor %}
{% for name, value in github_environment_secrets | dictsort %}
Set-GitHubSecret -Name '{{ name }}' -ValueBase64 '{{ value | string | b64encode }}'
{% endfor %}

Write-Host "GitHub Environment $Environment configured successfully."
