#!/usr/bin/env bash
set -euo pipefail

# Generated by Ansible for {{ inventory_hostname }}. Contains secrets.
REPOSITORY={{ github_repository | b64encode | quote }}
ENVIRONMENT={{ github_environment_name | b64encode | quote }}

decode() {
  printf '%s' "$1" | base64 --decode
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || {
    printf 'Missing required command: %s\n' "$1" >&2
    exit 1
  }
}

set_variable() {
  local name="$1" value
  value="$(decode "$2")"
  gh variable set "$name" --repo "$REPOSITORY" --env "$ENVIRONMENT" --body "$value"
}

set_secret() {
  local name="$1"
  decode "$2" | gh secret set "$name" --repo "$REPOSITORY" --env "$ENVIRONMENT"
}

require_command gh
require_command base64
REPOSITORY="$(decode "$REPOSITORY")"
ENVIRONMENT="$(decode "$ENVIRONMENT")"

gh auth status >/dev/null
printf 'Configuring GitHub Environment %s in %s\n' "$ENVIRONMENT" "$REPOSITORY"
gh api --method PUT "repos/$REPOSITORY/environments/$ENVIRONMENT" --silent

{% for name, value in github_environment_variables | dictsort %}
set_variable {{ name | quote }} {{ (value | string | b64encode) | quote }}
{% endfor %}
{% for name, value in github_environment_secrets | dictsort %}
set_secret {{ name | quote }} {{ (value | string | b64encode) | quote }}
{% endfor %}

printf 'GitHub Environment %s configured successfully.\n' "$ENVIRONMENT"
