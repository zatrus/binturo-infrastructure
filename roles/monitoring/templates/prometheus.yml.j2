global:
  scrape_interval: 15s
  evaluation_interval: 15s
  external_labels:
    environment: {{ environment_name | quote }}

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets: ["localhost:9090"]

  - job_name: node
    static_configs:
      - targets: ["node-exporter:9100"]

  - job_name: postgres
    metrics_path: /probe
    params:
      auth_module: [binturo]
    static_configs:
      - targets: ["postgresql://postgres:5432/{{ postgres_database }}"]
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: postgres-exporter:9187

  - job_name: binturo-platform
    static_configs:
      - targets: ["host.docker.internal:{{ binturo_ports.platform }}"]

  - job_name: binturo-organizers
    static_configs:
      - targets: ["host.docker.internal:{{ binturo_ports.organizers }}"]

{% if prometheus_remote_write_url | length > 0 %}
remote_write:
  - url: {{ prometheus_remote_write_url | quote }}
{% if prometheus_remote_write_username | length > 0 %}
    basic_auth:
      username: {{ prometheus_remote_write_username | quote }}
      password: {{ prometheus_remote_write_password | quote }}
{% endif %}
{% endif %}
